# ───────────────────────────────────────────────
# IOC Inspector – example environment file
# Copy to `.env` and replace the placeholders.
# ───────────────────────────────────────────────

# ▶ API KEYS
VT_API_KEY=                           # Optional: your VirusTotal API key
ABUSEIPDB_API_KEY=                     # Optional: your AbuseIPDB API key

# ▶ REPUTATION THRESHOLDS  (override defaults in settings.py)
VT_THRESHOLD=5               # vendors needed to flag URL/IP malicious
ABUSE_CONFIDENCE_CUTOFF=70   # AbuseIPDB confidence (0-100) to flag IP

# ▶ REPORT FORMATS  (comma-sep)
#   Available: markdown, json, csv, jsonl, html
REPORT_FORMATS=markdown,json
# REPORTS_DIR=reports       # default: reports/ in the working directory

# ▶ LOGGING
# LOG_LEVEL=DEBUG            # uncomment for verbose logs
# LOG_DIR=logs               # default: logs/ in the working directory
# LOG_MAX_BYTES=2000000      # per-file size before rotation (bytes)
# LOG_BACKUP_COUNT=3         # rotated log files to keep
